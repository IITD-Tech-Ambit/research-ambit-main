MONGODB_URI="your-mongo-connection-string"
JWT_SECRET="change-me-to-a-random-string-at-least-32-chars"
CLOUDINARY_CLOUD_NAME="devcluster"
CLOUDINARY_API_KEY="266666666666666"
CLOUDINARY_API_SECRET="devcluster"

# Atlas — all KG/Atlas data is served from MongoDB (published by
# knowledge-graph/pipeline/build_kg.py). KG_DATA_DIR only affects that offline
# pipeline now; the runtime no longer reads the filesystem.
# KG_DATA_DIR="./data/knowledge-graph"
# KG_ACTIVE_TTL_MS=30000   # how long the resolved active build version is cached
# KG_TILE_LRU_MAX=512      # in-process hot cache size for binary atlas tiles

# Redis (used for KG API response caching)
# REDIS_URL="redis://localhost:6379"
# KG_CACHE_TTL_S=10800

# gRPC (directory.v1 east-west mesh listener, fronted by Envoy)
# GRPC_ENABLED=true                 # set false to run REST-only
# GRPC_BIND_ADDRESS=0.0.0.0:50055   # frozen by the Envoy cluster contract
# PROTO_DIR=./protos                # committed proto copy (seeded by protos/sync.sh)

# Same value in api-gateway, backend and chatbot; proves x-user-* headers came from the gateway.
# Generate with: openssl rand -hex 32
GATEWAY_SHARED_SECRET=

# SMTP (IITD mail). Used for suggestion emails and "your profile was updated"
# notices. Nothing is sent or queued until MAIL_HOST, MAIL_USER and MAIL_PASS are set.
# Check the setup with: npm run mail:test -- --verify
# smtp.iitd.ac.in is only reachable from inside the IITD network.
MAIL_HOST=smtp.iitd.ac.in
MAIL_PORT=465                 # 465 = implicit TLS, 587 = STARTTLS (MAIL_SECURE overrides)
MAIL_USER=support_res_ambit   # bare kerberos id is expanded to <id>@iitd.ac.in for From
MAIL_PASS=
# MAIL_FROM=                  # From address, if different from MAIL_USER
# MAIL_REPLY_TO=support.rambit@iitd.ac.in   # where faculty replies to profile notices go
# MAIL_FROM_NAME="Research Ambit, IIT Delhi"
# MAIL_TO=researchambit@iitd.ac.in   # where suggestion emails go

# Profile-update notices go to <kerberos>@iitd.ac.in ONLY when MAIL_PROD=true.
# Any other value sends every notice to MAIL_DEV_TO instead.
MAIL_PROD=false
# MAIL_DEV_TO=ch7221511@iitd.ac.in
# PROFILE_UPDATE_EMAILS=false        # kill switch for profile-update notices
# PROFILE_MAIL_QUIET_MINUTES=10      # send after this long without further edits...
# PROFILE_MAIL_MAX_WAIT_MINUTES=30   # ...but no later than this after the first edit
# SITE_URL=https://researchambit.iitd.ac.in
